{
	"compilerOptions": {
		"baseUrl": ".",
		"target": "ES2018",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"lib": ["DOM", "ES2020"],
		"strict": true,
		"noImplicitReturns": true,
		"noUnusedLocals": true,
		"isolatedModules": true,
		"skipLibCheck": true,
		"types": []
	},
	"include": ["src/**/*.ts"]
}
